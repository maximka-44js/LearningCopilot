# Copy to backend/.env.prod for docker-compose.prod.yml
# cp .env.prod.example .env.prod

# Core app
APP_NAME=lc
APP_VERSION=1.0.0
LOG_LEVEL=info
APP_HTTP_PORT=8080

# PostgreSQL
POSTGRES_DB=db
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
PG_URL=postgres://replace-with-postgres-user:replace-with-postgres-password@db:5432/db?sslmode=disable

# One production domain. Services use <domain>, api.<domain> and auth.<domain>.
PUBLIC_DOMAIN=example.com
PUBLIC_SCHEME=https

# Required app secrets
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_BUCKET_NAME=replace-with-bucket
S3_ENDPOINT_URL=
S3_PORT=443
S3_USE_PATH_STYLE=false
S3_PRESIGN_EXPIRE=15m
# Public origins are derived from PUBLIC_DOMAIN by docker-compose.prod.yml.
SWAGGER_ENABLED=false
CORS_ALLOW_HEADERS=Authorization,Content-Type
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Keycloak (internal URLs for containers)
JWT_ISSUER=https://auth.example.com/realms/lc
JWT_DISCOVERY_ISSUER=http://keycloak:8080/realms/lc
JWT_CLIENT_ID=lc-frontend
KEYCLOAK_ADMIN=replace-with-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-keycloak-admin-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-keycloak-db-password
KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_PROXY_HEADERS=xforwarded

# Frontend auth runtime
FRONTEND_AUTH_SECRET=replace-with-long-random-secret
FRONTEND_AUTH_TRUST_HOST=true
FRONTEND_KEYCLOAK_ISSUER=http://keycloak:8080/realms/lc
FRONTEND_KEYCLOAK_CLIENT_ID=lc-frontend
FRONTEND_KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret

# Optional host port overrides
PROD_DB_HOST_PORT=5432
PROD_APP_HTTP_HOST_PORT=8080
PROD_KEYCLOAK_HOST_PORT=8082
PROD_KEYCLOAK_DB_HOST_PORT=5433
PROD_NGINX_HOST_PORT=80
