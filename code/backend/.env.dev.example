# Copy to backend/.env.dev for local docker-compose.dev.yml
# cp .env.dev.example .env.dev

# Core app
APP_NAME=lc
APP_VERSION=1.0.0
LOG_LEVEL=debug
APP_HTTP_PORT=8080

# Local PostgreSQL defaults used by docker-compose.dev.yml
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=myAwEsOm3pa55@w0rd
PG_URL=postgresql://user:myAwEs3pa55%40w0rd@db:5432/db

# Required app secrets
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_BUCKET_NAME=replace-with-bucket
S3_ENDPOINT_URL=
S3_PORT=443
S3_USE_PATH_STYLE=true
S3_PRESIGN_EXPIRE=15m
# Public origins
CORS_ALLOW_ORIGINS=http://frontend.lvh.me,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_HEADERS=Authorization,Content-Type
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Keycloak (internal URLs for containers)
JWT_ISSUER=http://localhost:8082/realms/lc
JWT_DISCOVERY_ISSUER=http://keycloak:8080/realms/lc
JWT_CLIENT_ID=lc-frontend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Frontend auth runtime
FRONTEND_AUTH_SECRET=replace-with-long-random-secret
FRONTEND_AUTH_URL=http://frontend.lvh.me
FRONTEND_NEXTAUTH_URL=http://frontend.lvh.me
FRONTEND_AUTH_TRUST_HOST=true
FRONTEND_KEYCLOAK_ISSUER=http://keycloak:8080/realms/lc
FRONTEND_KEYCLOAK_PUBLIC_ISSUER=http://localhost:8082/realms/lc
FRONTEND_KEYCLOAK_CLIENT_ID=lc-frontend
FRONTEND_KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
FRONTEND_NEXT_PUBLIC_API_BASE_URL=http://app.lvh.me/v1/

# Optional host port overrides
DEV_DB_HOST_PORT=5432
DEV_APP_HTTP_HOST_PORT=8080
DEV_KEYCLOAK_HOST_PORT=8082
DEV_KEYCLOAK_DB_HOST_PORT=5433
DEV_NGINX_HOST_PORT=80
