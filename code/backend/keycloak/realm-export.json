{
  "realm": "lc",
  "enabled": true,
  "registrationAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "en"
  ],
  "defaultLocale": "ru",
  "displayName": "LC",
  "loginTheme": "lc-keycloak-theme",
  "accountTheme": "lc-keycloak-theme",
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "lc-frontend",
      "name": "LC Frontend",
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://learning-copilot-ivr.ru/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "https://learning-copilot-ivr.ru"
      ],
      "frontchannelLogout": true,
      "attributes": {
        "frontchannel.logout.url": "https://learning-copilot-ivr.ru/api/auth/frontchannel-logout",
        "frontchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "+"
      }
    }
  ]
}
