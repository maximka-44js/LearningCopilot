resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade
{
    default upgrade;
    '' close;
}

server
{
    listen 80;
    server_name api.${PUBLIC_DOMAIN} ${PUBLIC_DOMAIN} auth.${PUBLIC_DOMAIN};

    location /.well-known/acme-challenge/
    {
        root /var/www/certbot;
    }

    location /
    {
        return 301 https://$host$request_uri;
    }
}

server
{
    listen 443 ssl;
    server_name api.${PUBLIC_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_DOMAIN}/privkey.pem;

    location = /metrics
    {
        return 404;
    }

    location /
    {
        set $backend_upstream app:8080;
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server
{
    listen 443 ssl;
    server_name ${PUBLIC_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_DOMAIN}/privkey.pem;
    proxy_buffer_size 4m;
    proxy_buffers 8 4m;
    proxy_busy_buffers_size 4m;

    location = /docs
    {
        return 301 /docs/;
    }

    location /docs/
    {
        proxy_pass http://frontend-docs:4173/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /_next/
    {
        set $frontend_next_upstream frontend-next:3000;
        proxy_pass http://$frontend_next_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /api/auth/
    {
        set $frontend_next_upstream frontend-next:3000;
        proxy_pass http://$frontend_next_upstream;
        proxy_buffer_size 4m;
        proxy_buffers 8 4m;
        proxy_busy_buffers_size 4m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /
    {
        set $frontend_next_upstream frontend-next:3000;
        proxy_pass http://$frontend_next_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server
{
    listen 443 ssl;
    server_name auth.${PUBLIC_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_DOMAIN}/privkey.pem;

    location /
    {
        set $keycloak_upstream keycloak:8080;
        proxy_pass http://$keycloak_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
