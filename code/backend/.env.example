# Copy this file to .env and fill secrets for local debugging.
# Keep .env out of Git; .gitignore already ignores .env in this repo.
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket
S3_ENDPOINT_URL=
S3_PORT=443
S3_USE_PATH_STYLE=true
S3_PRESIGN_EXPIRE=15m
CORS_ALLOW_HEADERS=*
